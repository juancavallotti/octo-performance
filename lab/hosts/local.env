# Host profile: the machine this lab currently runs on.
#
# One file per machine. The profile slug becomes part of every run id, so results
# captured on different hardware never collide and stay attributable.
#
# A future GCP runner drops in as lab/hosts/gce-<machine-type>.env with the same keys.

HOST_PROFILE=m1pro-16gb

# Where k6 sends load. The load generator and the server under test share this host
# for now; pointing BASE_URL at another machine is all that is needed to split them.
BASE_URL=http://localhost:8080

# Port the runtime binds. Must agree with BASE_URL.
HTTP_PORT=8080

# Container image for TARGET=docker. Pin to a tag or digest you intend to publish
# numbers against — "latest" makes results unattributable.
#
# Assigned conditionally: unlike the keys above, this one describes what is under
# test rather than the machine, so `OCTO_IMAGE=... task bench` has to win over the
# profile. (BUILD=dev bypasses it entirely and uses the locally built image.)
OCTO_IMAGE=${OCTO_IMAGE:-juancavallotti/octo-runtime:latest}

# The released binary for TARGET=native, BUILD=release. Deliberately not "whatever
# is on PATH": ~/go/bin/octo is whatever was last `go install`ed and drifts without
# anyone noticing, which is exactly the kind of unattributable baseline that makes
# a comparison worthless. Falls back to PATH when unset.
OCTO_BIN=${OCTO_BIN:-$HOME/.octo-versions/octo-0.4.3}
