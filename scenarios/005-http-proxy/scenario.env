# Scenario 005 — HTTP proxy. The canonical API-gateway shape.
#
# Anything here is a DEFAULT: a value already set in the environment wins.

# The proxied route. The path parameter is not used by the flow; it is there so the
# route shape matches a real resource-oriented API rather than a fixed path.
ROUTE=/proxy/acct-42

# The measured route reaches the backend, so probing it for readiness would report
# the backend's health rather than the runtime's.
READY_ROUTE=/health

TUNABLES="workers buffer pool"

# --- backend ------------------------------------------------------------------
# 70 ms stands in for a real remote dependency — a database-backed service across an
# availability zone, or a third-party API over the internet. Everything about this
# scenario follows from it: it is long enough that holding requests in flight, not
# computing them, is what the runtime is being asked to do.
BACKEND_PORT=9090
BACKEND_URL=http://localhost:9090
BACKEND_DELAY=70ms
# 1 KB is a typical API response. Set BACKEND_SIZE=1048576 for the large-payload
# case, which measures copying rather than concurrency.
BACKEND_SIZE=1024

# --- steady state -------------------------------------------------------------
# Chosen so the two arms cannot both pass, because that IS the result.
#
# Out of the box the flow blocks for 70 ms on 8 workers, so it cannot exceed
# 8 / 0.070 = 114 req/s no matter how much load is offered — measured at 107.5 req/s
# and flat from 8 VUs to 200 VUs. With workers raised it reaches ~1,780 req/s on
# this host. 800 req/s sits between the two: the tuned arm holds it, the baseline
# arm sheds roughly 85% of the offered load.
#
# The baseline arm's dropped_iterations here are genuine server saturation, not the
# generator artifact that bit this lab before: no VU pool can sustain 800 req/s
# against a hard 108 req/s ceiling.
STEADY_RATE=800
STEADY_DURATION=60s
WARMUP_DURATION=10s

# --- capacity -----------------------------------------------------------------
CAPACITY_START_RATE=50
CAPACITY_PEAK_RATE=3000
CAPACITY_STEP_DURATION=15s
CAPACITY_STEPS=10

# --- closed-model VU sweep ----------------------------------------------------
# For comparability with closed-model published benchmarks; see COMPARISON.md. The
# ladder stops where k6 itself would become the bottleneck, the generator sharing
# this host.
SCENARIO_VU_LEVELS="1 10 50 100 200 400 800"
VU_DURATION=30s

# --- k6 client sizing ---------------------------------------------------------
# Dominated by the backend delay, not by the runtime.
EXPECTED_LATENCY_MS=90

# --- thresholds ---------------------------------------------------------------
# A pass means the proxy added little to the backend's own 70 ms.
THRESHOLD_P95_MS=200
THRESHOLD_P99_MS=500

# --- sweep grid ---------------------------------------------------------------
# workers is the axis that matters here by a wide margin; buffer and pool barely
# move it, because nothing in this flow is queued or forked.
SCENARIO_SWEEP_WORKERS="8 64 256 512"
SCENARIO_SWEEP_BUFFER="64 1024"
SCENARIO_SWEEP_POOL="8"

SAMPLE_INTERVAL=1.0

# --- container target ---------------------------------------------------------
# The backend runs natively on the host; localhost inside a container is the
# container. Only the docker target reads this.
DOCKER_ENV="BACKEND_URL=http://host.docker.internal:9090"
