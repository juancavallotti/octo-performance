# Scenario 003 — Postgres CRUD.
#
# Anything here is a DEFAULT: a value already set in the environment wins.

ROUTE=/order
# The measured route is a POST requiring a body; probe the health flow instead.
# That flow issues a SELECT, so "ready" means the connection pool works too.
READY_ROUTE=/health

# The knobs this scenario exposes. Two competing limits: the flow's worker count
# and the connector's connection pool. More workers than connections just moves
# the queue from the message channel to the pool, which is the interaction this
# scenario exists to measure.
TUNABLES="workers buffer pool maxOpenConns maxIdleConns"

# --- steady state ------------------------------------------------------------
# Three Postgres round trips per request against a container on the same host.
# Far below the CPU-bound scenarios; calibrate with `task capacity` first.
STEADY_RATE=1500
STEADY_DURATION=60s
WARMUP_DURATION=10s

# --- capacity ----------------------------------------------------------------
CAPACITY_START_RATE=200
CAPACITY_PEAK_RATE=6000
CAPACITY_STEP_DURATION=15s
CAPACITY_STEPS=10

# --- k6 client sizing --------------------------------------------------------
# Database latency dominates and its tail is long, so size the VU pool generously
# or the generator sheds iterations and it reads as server saturation.
EXPECTED_LATENCY_MS=60

# --- thresholds --------------------------------------------------------------
THRESHOLD_P95_MS=100
THRESHOLD_P99_MS=300

# --- sweep grid --------------------------------------------------------------
# The interesting axis is workers against maxOpenConns. sweep.sh drives the
# root-flow trio; use `task bench` with TUNED_MAXOPENCONNS to explore the pool.
SCENARIO_SWEEP_WORKERS="8 32 64"
SCENARIO_SWEEP_BUFFER="64 256"
SCENARIO_SWEEP_POOL="8"

# --- postgres ----------------------------------------------------------------
# Consumed by setup.sh/teardown.sh. PG_DSN in integration.yaml must agree with
# PG_PORT and PG_DB.
PG_CONTAINER=octo-bench-pg
PG_IMAGE=postgres:17-alpine
PG_PORT=55432
PG_DB=octobench
PG_PASSWORD=octobench

SAMPLE_INTERVAL=1.0
