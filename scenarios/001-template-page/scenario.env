# Scenario 001 — template page. Knobs the harness and the k6 tests read.
#
# Anything here is a DEFAULT: a value already set in the environment wins, so
# `STEADY_DURATION=15s task bench ...` shortens a run without editing this file.

# The route under test. The last path segment becomes the template's {name}.
ROUTE=/page/octo

# --- steady state (the headline comparison) ---------------------------------
# Calibrated from the capacity ramp on m1pro-16gb / octo 0.4.2: CPU scaled
# linearly to ~310% of one core at 36k req/s, then folded over at 40k (CPU fell
# to 260% while k6 shed 9161 iterations). The knee is 32-36k req/s, so 24k sits
# at roughly two thirds of capacity: enough queueing pressure for tuning to show,
# with headroom so a healthy baseline never drops an iteration.
#
# Re-run `task capacity` on new hardware or a new Octo version before trusting it.
STEADY_RATE=24000
STEADY_DURATION=60s

# Discarded pass before each measurement, to pay for Go runtime warm-up,
# connection establishment, and lazy initialisation.
WARMUP_DURATION=10s

# --- capacity (find the knee) ------------------------------------------------
CAPACITY_START_RATE=2000
CAPACITY_PEAK_RATE=40000
CAPACITY_STEP_DURATION=15s
CAPACITY_STEPS=10

# --- k6 client sizing --------------------------------------------------------
# Drives the VU pool via Little's law (concurrency = rate x service time). An
# over-sized pool steals CPU from the server on this colocated host, so keep it
# near observed latency rather than padding it arbitrarily.
EXPECTED_LATENCY_MS=5

# --- thresholds --------------------------------------------------------------
# What this scenario should hold at STEADY_RATE. A breach does not abort the run;
# it is recorded in the report's validity table.
THRESHOLD_P95_MS=20
THRESHOLD_P99_MS=50

# --- sweep grid --------------------------------------------------------------
# Explored by `task sweep`. Keep it small: every combination is a full start,
# warm-up, and measured run.
SCENARIO_SWEEP_WORKERS="8 16 32 64"
SCENARIO_SWEEP_BUFFER="64 256 1024"
SCENARIO_SWEEP_POOL="8"

# Resource sampling interval, seconds.
SAMPLE_INTERVAL=1.0
