# Scenario 006 — payload transformation.
#
# Anything here is a DEFAULT: a value already set in the environment wins.

# The primary route: CEL's native .map(). Point ROUTE at /transform-foreach to
# measure the foreach implementation of the identical transformation instead.
ROUTE=/transform
READY_ROUTE=/health

TUNABLES="workers buffer pool"

# --- payload ladder -----------------------------------------------------------
# Target request size in bytes; the generator grows the record count until the
# serialised document reaches it. Roughly 9 records per KB.
#   1024    ->    9 records
#   102400  ->  753 records
#   1048576 -> ~7700 records
PAYLOAD_BYTES=1024

# --- steady state -------------------------------------------------------------
# Measured 11,659 req/s at 4 VUs with the 1 KB payload on m1pro-16gb / 0.4.3, with
# the generator on the same host. 4,000 leaves the generator ample headroom, which
# matters more here than in most scenarios: k6 has to serialise the request body
# every iteration, so an over-ambitious rate measures k6.
STEADY_RATE=4000
STEADY_DURATION=60s
WARMUP_DURATION=10s

# --- capacity -----------------------------------------------------------------
CAPACITY_START_RATE=200
CAPACITY_PEAK_RATE=12000
CAPACITY_STEP_DURATION=15s
CAPACITY_STEPS=10

# --- closed-model VU sweep ----------------------------------------------------
# Transformation is CPU-bound, so its knee arrives at far lower concurrency than the
# proxy's. The ladder brackets it. See COMPARISON.md.
SCENARIO_VU_LEVELS="1 5 10 25 50 100 300"
VU_DURATION=30s

# --- k6 client sizing ---------------------------------------------------------
EXPECTED_LATENCY_MS=5

# --- thresholds ---------------------------------------------------------------
THRESHOLD_P95_MS=50
THRESHOLD_P99_MS=120

# --- sweep grid ---------------------------------------------------------------
# Expected to find nothing: this flow never blocks, so extra workers only add
# scheduling overhead. Recorded anyway — "tuning does not help here" is a result,
# and it is the control that makes scenario 005's 16x credible.
SCENARIO_SWEEP_WORKERS="8 32 128"
SCENARIO_SWEEP_BUFFER="64 512"
SCENARIO_SWEEP_POOL="8"

SAMPLE_INTERVAL=1.0
