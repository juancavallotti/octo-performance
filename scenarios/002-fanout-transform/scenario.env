# Scenario 002 — fan-out and transform.
#
# Anything here is a DEFAULT: a value already set in the environment wins.

# POST route. The path parameter becomes the order id.
ROUTE=/order/o-1001

# Readiness is probed with a bare GET, which the POST route above would reject, so
# point it at the scenario's trivial health flow instead.
READY_ROUTE=/health

# The knobs this scenario exposes. Unlike 001, `pool` is genuinely exercised here:
# the fork hands its three branches to the shared worker pool.
TUNABLES="workers buffer pool"

# --- steady state ------------------------------------------------------------
# Far below scenario 001's rate: every request now runs a multi-transform, a
# three-branch fork, a mapped foreach over the order lines, and two flow-refs.
# Calibrate with `task capacity` before trusting this on new hardware.
STEADY_RATE=4000
STEADY_DURATION=60s
WARMUP_DURATION=10s

# --- capacity ----------------------------------------------------------------
CAPACITY_START_RATE=500
CAPACITY_PEAK_RATE=12000
CAPACITY_STEP_DURATION=15s
CAPACITY_STEPS=10

# --- payload shape -----------------------------------------------------------
# Order lines per request. More lines means more foreach iterations, so this is
# the knob that decides how CPU-heavy each message is.
ORDER_LINES=8

# --- k6 client sizing --------------------------------------------------------
# Size from the tail, not the median: a pool exhausted by a latency spike sheds
# iterations, which reads as server saturation when it is a generator artifact.
EXPECTED_LATENCY_MS=25

# --- thresholds --------------------------------------------------------------
THRESHOLD_P95_MS=50
THRESHOLD_P99_MS=150

# --- sweep grid --------------------------------------------------------------
# pool is the interesting axis here — it decides how much of the fork actually
# runs in parallel.
SCENARIO_SWEEP_WORKERS="8 32"
SCENARIO_SWEEP_BUFFER="64 256"
SCENARIO_SWEEP_POOL="2 8 32"

SAMPLE_INTERVAL=1.0
