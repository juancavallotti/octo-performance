# Scenario 004 — internal queue round trip.
#
# Anything here is a DEFAULT: a value already set in the environment wins.

ROUTE=/job
# The measured route is a POST requiring a body; probe the health flow instead.
READY_ROUTE=/health

# Each knob is declared in exactly one place in integration.yaml, so they do not
# collide: workers/buffer/pool tune the HTTP producer, listeners the queue consumer.
TUNABLES="workers buffer pool listeners"

# --- steady state ------------------------------------------------------------
# The producer blocks on awaitReply, so like scenario 003 this saturates well
# below the CPU-bound scenarios. Calibrate with `task capacity` first.
STEADY_RATE=3000
STEADY_DURATION=60s
WARMUP_DURATION=10s

# --- capacity ----------------------------------------------------------------
CAPACITY_START_RATE=500
CAPACITY_PEAK_RATE=15000
CAPACITY_STEP_DURATION=15s
CAPACITY_STEPS=10

# --- k6 client sizing --------------------------------------------------------
# A queue round trip has a longer tail than a bare HTTP call; size from it or the
# generator sheds iterations and it reads as server saturation.
EXPECTED_LATENCY_MS=40

# --- thresholds --------------------------------------------------------------
THRESHOLD_P95_MS=80
THRESHOLD_P99_MS=250

# --- sweep grid --------------------------------------------------------------
# sweep.sh drives the root-flow trio; pair it with TUNED_LISTENERS to explore the
# producer/consumer interaction, which is the point of this scenario.
SCENARIO_SWEEP_WORKERS="8 32 128"
SCENARIO_SWEEP_BUFFER="64 256"
SCENARIO_SWEEP_POOL="8"

SAMPLE_INTERVAL=1.0
