.DS_Store
*.swp

# Staged single-variant configs built by lab/bin/stage-config.sh
.stage/

# Local scratch
.scratch/
tmp/

# Per-block profiles from `task profile`. Deliberately not published: a profiled run
# carries instrumentation around every block, so its numbers describe the harness as
# much as the runtime. It is a tool for forming a hypothesis, and the hypothesis —
# once re-measured through `task bench` — is what gets committed.
diagnostics/

# k6 raw per-request output (huge); we keep handleSummary JSON instead
*.k6-raw.json

# Local host profile overrides that are not meant to be shared
lab/hosts/*.local.env

# Python bytecode
__pycache__/
*.pyc
